{
  "name": "avc",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Windows local video library organizer: detect titles from filenames, fetch metadata, rename by template, download subtitles. Dry-run by default, journaled changes and conservative undo.",
